# ============================================================
# Configuração do Ambiente - ERP Prado da Costa
# ============================================================

# --- Banco de Dados ---
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=erp_pradodacosta
DB_USER=frappe_user
DB_PASSWORD=frappe_pass_123

# --- Frappe Bench ---
SITE_NAME=erp.pradodacosta.local
BENCH_DEVELOPER_MODE=1
ADMIN_PASSWORD=admin123

# --- Redis ---
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-cache:6379
REDIS_SOCKETIO=redis://redis-cache:6379

# --- ACBr (Serviços Fiscais Brasileiros) ---
ACBR_HOST=acbr
ACBR_PORT=8080
ACBR_AMBIENTE=homologacao   # homologacao | producao

# --- Docker ---
COMPOSE_PROJECT_NAME=erp-pradodacosta